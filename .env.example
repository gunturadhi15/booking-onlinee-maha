# ==============================================================================
# Mahawellnerjourney - Security Environment Configuration Template
# Salin file ini menjadi .env.local (development) atau isi pada dashboard hosting (Vercel/Render/VPS)
# PENTING: JANGAN PERNAH commit file .env atau .env.local ke Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client (Publik - Client-side safe: hanya anon key dengan RLS ketat)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Catatan: Variabel berawalan NEXT_PUBLIC_ atau VITE_ dapat dibaca oleh browser.
# JANGAN PERNAH meletakkan Service Role Key di sini!

# ------------------------------------------------------------------------------
# 2. Supabase Server-Only (Opsional untuk background admin sync / worker)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# ------------------------------------------------------------------------------
# 3. Server-Side Authentication & Secret Tokens (Backend Only)
# ------------------------------------------------------------------------------
# Token rahasia untuk endpoint admin (/api/bookings, /api/bookings/export).
# Gunakan string acak minimal 32 karakter (contoh: openssl rand -hex 32)
ADMIN_API_TOKEN=change-this-to-a-secure-random-secret-token-min-32-chars

# ------------------------------------------------------------------------------
# 4. Payment Gateway Webhook & Signature Secret (Backend Only)
# ------------------------------------------------------------------------------
# Server key dari dashboard payment gateway (Midtrans / Xendit) untuk verifikasi signature webhook
PAYMENT_GATEWAY_SERVER_KEY=your-midtrans-or-payment-server-key

# Izinkan simulasi pembayaran instan (Set "false" di PRODUCTION!)
ALLOW_SIMULATED_PAYMENTS=false

# ------------------------------------------------------------------------------
# 5. Server Environment & Network Security
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Izinkan CORS hanya dari domain resmi Anda (pisahkan dengan koma jika multiple)
ALLOWED_ORIGINS=https://mahawellnerjourney.com,https://www.mahawellnerjourney.com

# Set "true" jika backend berada di belakang Reverse Proxy (Cloudflare, Nginx, Vercel)
# agar rate limiter membaca IP asli klien via X-Forwarded-For
TRUST_PROXY=false
